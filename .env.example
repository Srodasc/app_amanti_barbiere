# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Recordatorios por WhatsApp (Cloud API de Meta)
CRON_SECRET=una_clave_larga_aleatoria
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TPL_CONFIRMACION=
WHATSAPP_TPL_RECORDATORIO=
WHATSAPP_TPL_CANCELACION=
# Con DRY_RUN=true no se envía nada, solo se registra (para probar)
WHATSAPP_DRY_RUN=true

# Captcha en la reserva (Cloudflare Turnstile). Pon LAS DOS o ninguna.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
